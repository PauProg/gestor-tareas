{% extends 'base.html.twig' %}

{% block title %}Tareas | Gestor de tareas{% endblock %}
{% block body %}
  <h1>Gestor de tareas</h1>
  <p>{{ bienvenida }}</p>
  <p><a href="{{ path('tarea_nueva') }}">+ Nueva tarea</a></p>

  <ul>
    {% for tarea in tareas %}
      <li class="tarea">
        <span>#{{ tarea.id }}</span>
        <strong>
          <a href="{{ path('tarea_detalle', {id: tarea.id}) }}">{{ tarea.titulo }}</a>
        </strong>
        <p>{{ tarea.descripcion }}</p>
        <span>{{ tarea.estado|capitalize }}</span>
      </li>
    {% else %}
      <li>No hay tareas todavía.</li>
    {% endfor %}
  </ul>
{% endblock %}